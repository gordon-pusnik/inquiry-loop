OPENAI_API_KEY=your-api-key
# AGENT_MODEL=gpt-6.2-sol
# Sol and Astra accept low, medium, high, and max. The default is medium.
# Use /effort to change this for the running CLI session.
# OPENAI_REASONING_EFFORT=medium

# Hosted evidence checking for --research and interactive /research.
# TYPESAFE_API_KEY=your-typesafe-api-key

# Default MLX model; --model overrides this for one run.
MLX_MODEL=mlx-community/Qwen3-30B-A3B-Instruct-2507-4bit

# llama.cpp settings
# Optional executable path for llama-server or the unified llama CLI.
# LLAMA_SERVER=~/.local/bin/llama
# Use the .gguf snapshot path printed by hf download.
# LLAMA_MODEL_PATH=/path/to/model.gguf
# LLAMA_MAX_TOKENS=16384
# LLAMA_CONTEXT_SIZE=32768
